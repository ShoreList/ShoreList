{
  "_notes": [
    "Keyword template for one city site. Clones copy this file, change `vars`, `clusters` and `pages`, and run: node tools/check-keywords.mjs --config <file>",
    "Search volume is never stored here. Rank clusters by intent tier (T1 book or buy, T2 plan a trip, T3 quick answer) until Search Console data exists.",
    "Every title, meta description and H1 must be written by hand for the city. This file checks them, it does not generate them.",
    "See docs/SEO-KEYWORDS.md for the full method."
  ],
  "vars": {
    "city": "Wilmington",
    "st": "NC",
    "stateName": "North Carolina",
    "island": "Pleasure Island",
    "brand": "ShoreList",
    "beaches": ["Wrightsville Beach", "Carolina Beach", "Kure Beach"]
  },
  "rules": {
    "titleMax": 62,
    "titleMin": 25,
    "descMax": 165,
    "descMin": 70,
    "noDashes": true,
    "uniqueTitles": true,
    "uniqueDescriptions": true,
    "uniqueH1": true
  },
  "patterns": {
    "activity": {
      "primary": "{activity} {city} {st}",
      "variants": ["best {activity} in {city} {st}", "{activity} near {city}", "{activity} {beach}", "{activity} for families", "{activity} this weekend"],
      "title": "{Activity} in {city}, {st} | {hook}",
      "h1": "{Activity} in {city}, {st}"
    },
    "beach": {
      "primary": "{beach} {st}",
      "variants": ["things to do in {beach}", "{beach} activities", "{beach} with kids", "{beach} parking", "{beach} tides", "{beach} events"],
      "title": "{beach}, {st}: Things to Do & {hook}"
    },
    "events": {
      "primary": "{city} {st} events",
      "variants": ["events in {city} {st} this weekend", "{city} {st} events {month}", "{city} {st} festivals", "{beach} events"]
    },
    "stay": {
      "primary": "where to stay in {city} {st}",
      "variants": ["best area to stay in {city} {st}", "downtown {city} vs {beach}"]
    },
    "parking": {
      "primary": "parking in {city} {st}",
      "variants": ["{beach} parking", "downtown {city} parking decks"]
    },
    "weather": {
      "primary": "{city} {st} weather",
      "variants": ["{beach} tides", "{beach} surf report", "{city} {st} water temperature"]
    },
    "shop": {
      "primary": "{city} {st} souvenirs",
      "variants": ["{beach} shirts", "{beach} hats", "{city} {st} gifts", "{city} {st} art prints"]
    }
  },
  "pages": [
    { "url": "/", "cluster": "hub", "tier": "T2", "primary": "things to do in {city}", "geo": ["{city}"] },
    { "url": "/things-to-do", "cluster": "hub", "tier": "T2", "primary": "{city}", "geo": ["{city}"], "also": ["things to do", "activities"] },
    { "url": "/things-to-do/ghost-tours", "cluster": "ghost-tours", "tier": "T1", "primary": "ghost tours", "geo": ["{city}"] },
    { "url": "/things-to-do/walking-tours", "cluster": "walking-tours", "tier": "T1", "primary": "walking tours", "geo": ["{city}"] },
    { "url": "/things-to-do/museums", "cluster": "museums", "tier": "T2", "primary": "museums", "geo": ["{city}"] },
    { "url": "/things-to-do/film-tours", "cluster": "film-tours", "tier": "T1", "primary": "film", "geo": ["{city}"] },
    { "url": "/things-to-do/fishing-charters", "cluster": "fishing-charters", "tier": "T1", "primary": "fishing charters", "geo": ["{city}", "Carolina Beach"] },
    { "url": "/things-to-do/kayak-tours", "cluster": "kayak-tours", "tier": "T1", "primary": "kayak tours", "geo": ["{city}", "Wrightsville Beach"] },
    { "url": "/things-to-do/river-cruises", "cluster": "river-cruises", "tier": "T1", "primary": "river cruises", "geo": ["{city}"] },
