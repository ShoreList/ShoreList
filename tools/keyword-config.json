    { "url": "/gift-guide", "cluster": "shop", "tier": "T1", "primary": "gift", "geo": ["Carolina"] },
    { "url": "/shop/wrightsville-beach", "cluster": "shop", "tier": "T1", "primary": "souvenirs", "geo": ["Wrightsville Beach"] },
    { "url": "/shop/carolina-beach", "cluster": "shop", "tier": "T1", "primary": "souvenirs", "geo": ["Carolina Beach"] },
