    { "url": "/things-to-do/ebike-rentals", "cluster": "bikes", "tier": "T1", "primary": "e-bike rentals", "geo": ["{city}"] },
    { "url": "/things-to-do/scooter-rentals", "cluster": "rentals", "tier": "T1", "primary": "scooter rentals", "geo": ["{city}", "Carolina Beach"] },
