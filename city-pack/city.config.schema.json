{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorelist.net/city-pack/city.config.schema.json",
  "title": "ShoreList city pack config",
  "description": "Everything that differs per city and is currently hard-coded across the Wilmington generators and pages. Additive spec only: no current generator reads this yet.",
  "type": "object",
  "required": [
    "id",
    "name",
    "domain",
    "state",
    "timezone",
    "center",
    "tax",
    "areas",
    "categories",
    "nav",
    "brand",
    "umbrella",
    "contact",
    "analytics",
    "stripe",
    "launchGate"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "description": "City name as written in titles and prose, e.g. Wilmington"
    },
    "region": {
      "type": "string",
      "description": "Short regional descriptor, e.g. the Cape Fear coast area (watch banned phrases in check-site)"
    },
    "siteName": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
    },
    "siteUrl": {
      "type": "string",
      "format": "uri"
    },
    "locale": {
      "type": "string",
      "default": "en-US"
    },
    "state": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "country": {
      "type": "string",
      "default": "US"
    },
    "timezone": {
      "type": "string",
      "description": "IANA zone used for 'today', weekend and event offsets"
    },
    "center": {
      "$ref": "#/$defs/latlng"
    },
    "tax": {
      "type": "object",
      "required": [
        "rate",
        "basis"
      ],
      "properties": {
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rate"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rate": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "basis": {
          "type": "string",
          "description": "Where the tax is sourced, with a citation or the date it was checked"
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/area"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "eventCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nav": {
      "type": "object",
      "required": [
        "primary",
        "footer"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        },
        "footer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": [
        "wordmark",
        "colors"
      ],
      "properties": {
        "wordmark": {
          "type": "string"
        },
        "themeColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "voiceNotes": {
          "type": "string"
        },
        "ownAssetsRequired": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "umbrella": {
      "type": "object",
      "required": [
        "name",
        "url",
        "footerLine",
        "aboutNetworkPath"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "footerLine": {
          "type": "string"
        },
        "aboutNetworkPath": {
          "type": "string",
          "description": "Path of the public About the network page on this site"
        },
        "legalEntity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": [
        "publicEmail",
        "opsEmail"
      ],
      "properties": {
        "publicEmail": {
          "type": "string"
        },
        "opsEmail": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "mailingLine": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "analytics": {
      "type": "object",
      "properties": {
        "ga4MeasurementId": {
          "type": "string"
        },
        "searchConsoleVerification": {
          "type": "string"
        },
        "bingVerification": {
          "type": "string"
        },
        "indexNowKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stripe": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "test",
            "live"
          ]
        },
        "accountId": {
          "type": "string",
          "description": "Separate Stripe account per site so a site can be sold alone"
        },
        "secretKeyEnvVar": {
          "type": "string"
        },
        "webhookSecretEnvVar": {
          "type": "string"
        },
        "connectAccountIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "weather": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "lat",
              "lon"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "sea": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "additionalProperties": false
          }
        },
        "noaaTideStation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "launchGate": {
      "type": "object",
      "required": [
        "minLiveOperators",
        "minVerifiedEvents60d",
        "minHandWrittenGuides",
        "minOwnPhotos"
      ],
      "properties": {
        "minLiveOperators": {
          "type": "integer",
          "minimum": 0
        },
        "minVerifiedEvents60d": {
          "type": "integer",
          "minimum": 0
        },
        "minHandWrittenGuides": {
          "type": "integer",
          "minimum": 0
        },
        "minOwnPhotos": {
          "type": "integer",
          "minimum": 0
        },
        "thinContent": {
          "type": "object",
          "description": "Defaults for tools/thin-content-gate.mjs",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "localEntities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Named local places the thin-content gate looks for on each page (beyond area names and event venues)."
    }
  },
  "$defs": {
    "latlng": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "required": [
        "slug",
        "key",
        "name",
        "center",
        "guidePath"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Value of the area field in events-data.json"
        },
        "name": {
          "type": "string"
        },
        "locality": {
          "type": "string",
          "description": "addressLocality used in Event JSON-LD"
        },
        "center": {
          "$ref": "#/$defs/latlng"
        },
        "guidePath": {
          "type": "string"
        },
        "blurb": {
          "type": "string",
          "description": "Hand-written, per city. Never reuse across packs."
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "required": [
        "slug",
        "label"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "photoKey": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contentSource": {
          "type": "string",
          "description": "Where the per-city h1/title/desc/intro/faq lives for this category"
        }
      },
      "additionalProperties": false
    },
    "navItem": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}